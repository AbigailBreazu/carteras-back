PORT=3000

# Postgres / TypeORM
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here
DB_DATABASE=carteras_db
TYPEORM_SYNC=false

# MongoDB (usado por algunas colecciones de Canva)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>

# SMTP (emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_password_here

# Cloudinary (opcional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Supabase (opcional)
SUPABASE_URL=
SUPABASE_KEY=

# Otros (añadir según necesidad)
SECRET_KEY=your_app_secret
# Backend URL base para servir imágenes
BASE_URL=http://localhost:3000
